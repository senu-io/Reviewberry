# AMD Token Factory Configuration
# Obtain your key from notebooks.amd.com/tokenfactory after all team members click "Redeem API Key"
RADEON_API_KEY=rc-000000000000000000000000000000000000000000000000
RADEON_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_MODEL=DeepSeek-V4-Flash

# Server configuration
PORT=8000
HOST=0.0.0.0

# Fallback mode: If true, when no valid AMD API key is supplied or rate limit is reached,
# high-fidelity realistic AI synthesis is simulated so demos and judges are never blocked.
USE_MOCK_FALLBACK=true
